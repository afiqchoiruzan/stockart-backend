PORT=5000
# Optional: maximum auth requests per IP per 15 minutes.
# Defaults to 100 locally and 10 when NODE_ENV=production.
# AUTH_RATE_LIMIT_MAX=100
# Checkout/void require MongoDB Atlas or a replica set (not standalone).
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:3000
SMTP_USER=stockartapp@gmail.com
SMTP_PASS=your-16-digit-google-app-password
OWNER_EMAIL=owner@example.com
GDRIVE_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec

