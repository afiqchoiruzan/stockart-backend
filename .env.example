PORT=5000
# Toggle Database: true = MongoDB Atlas Cloud, false = MongoDB Lokal
USE_ATLAS=true
# Checkout/void require MongoDB Atlas or a replica set (not standalone).
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
MONGO_URI_ATLAS=mongodb+srv://<username>:<password>@<cluster>/<database>
MONGO_URI_LOCAL=mongodb://127.0.0.1:27017/stockart_db
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:3000
SMTP_USER=stockartapp@gmail.com
SMTP_PASS=your-16-digit-google-app-password
OWNER_EMAIL=owner@example.com
# Opsional: gunakan Brevo HTTP API (port 443) untuk lingkungan cloud seperti Railway yang memblokir port SMTP
BREVO_API_KEY=
EMAIL_FROM=
# Scheduler Digest Low Stock (WIB UTC+7) & Alert Kritis Stok Habis
LOW_STOCK_SCHEDULER_ENABLED=true
LOW_STOCK_SCHEDULER_INTERVAL_MS=60000
LOW_STOCK_DIGEST_FREQUENCY=weekly
LOW_STOCK_DIGEST_TIME=07:00
LOW_STOCK_DIGEST_WEEKDAY=1
LOW_STOCK_DIGEST_DAY_OF_MONTH=1
LOW_STOCK_CRITICAL_ALERT_ENABLED=true
GDRIVE_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec

# Midtrans (QRIS) - HANYA sandbox. Server key dari dashboard sandbox: Settings > Access Keys.
MIDTRANS_SERVER_KEY=
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com
