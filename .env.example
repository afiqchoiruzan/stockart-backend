PORT=5000
# Toggle Database: true = MongoDB Atlas Cloud, false = MongoDB Lokal
USE_ATLAS=true
# Checkout/void require MongoDB Atlas or a replica set (not standalone).
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
MONGO_URI_ATLAS=mongodb+srv://<username>:<password>@<cluster>/<database>
MONGO_URI_LOCAL=mongodb://127.0.0.1:27017/stockart_db
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:3000
SMTP_USER=stockartapp@gmail.com
SMTP_PASS=your-16-digit-google-app-password
OWNER_EMAIL=owner@example.com
GDRIVE_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec

